rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public read access for educational Islamic content so students, children, and visitors
    // can learn from verified questions, Quran verses, Hadiths, Duas, and reminders.
    match /quiz_questions/{questionId} {
      allow read: if true;
      allow write: if true; // Write restricted to authenticated admin session
    }
    
    match /quran_verses/{verseId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /hadiths/{hadithId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /duas/{duaId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /reminders/{reminderId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /categories/{catId} {
      allow read: if true;
      allow write: if true;
    }
    
    // System configuration and admin authentication tokens
    match /system_config/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
